<script>

/* SIMPLE CONTACT HANDLER */

function contact(work){

/* replace with your email or assistant email */
const email = "your@email.com";

const subject =
"ACQUISITION REQUEST — " + work;

const body =
"Hello,\n\nI am interested in acquiring / commissioning:\n" +
work +
"\n\nPlease provide further information.";

window.location.href =
`mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

}

</script>

</body>
</html>
